import React from "react"
import { Link } from "gatsby"

import Menu, { BottomBar } from "./menu"
import ThemeToggle from "./theme-toggle"
import SiteFooter from "./site-footer"

function Layout({ title, children }) {
  return (
    <>
      <a href="#main" className="skip-link">
        Skip to main content
      </a>
      <header>
        <div className="mx-auto flex max-w-site min-h-[4.5rem] items-center justify-between gap-4 px-5 py-2 sm:px-8">
          <Link
            to={`/`}
            className="inline-flex min-h-11 items-center font-display text-xl text-ink"
          >
            {title}
          </Link>
          <div className="flex items-center gap-2 sm:gap-4">
            <Menu />
            <ThemeToggle />
          </div>
        </div>
      </header>
      <main
        id="main"
        tabIndex={-1}
        className="mx-auto min-h-[400px] w-full max-w-site px-5 pb-20 pt-8 sm:px-8 sm:pb-28 sm:pt-14"
      >
        {children}
      </main>
      <SiteFooter />
      <BottomBar />
    </>
  )
}

export default Layout
