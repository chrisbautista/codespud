import React from "react"
import { Link, useStaticQuery, graphql } from "gatsby"

const linkClass =
  "inline-flex min-h-11 min-w-11 items-center justify-center underline underline-offset-[0.2em] hover:text-ink"

// Footer: site links, short disclaimer, copyright, back to top.
export default function SiteFooter() {
  const data = useStaticQuery(graphql`
    query FooterQuery {
      site {
        siteMetadata {
          social {
            linkedin
            github
          }
        }
      }
    }
  `)
  const { social } = data.site.siteMetadata

  return (
    <footer className="border-t border-divider">
      <div className="mx-auto grid max-w-site gap-6 px-5 pb-12 pt-10 text-[0.85rem] leading-[1.6] text-muted sm:px-8">
        <ul className="flex flex-wrap gap-x-4">
          <li>
            <Link to="/" className={linkClass}>
              Blog
            </Link>
          </li>
          <li>
            <Link to="/works" className={linkClass}>
              Works
            </Link>
          </li>
          <li>
            <Link to="/about-me" className={linkClass}>
              About
            </Link>
          </li>
          <li>
            <a href="/rss.xml" className={linkClass}>
              RSS
            </a>
          </li>
          <li>
            <a href={social.github} className={linkClass}>
              GitHub
            </a>
          </li>
          <li>
            <a href={social.linkedin} className={linkClass}>
              LinkedIn
            </a>
          </li>
        </ul>
        <p className="max-w-[60ch]">
          This is my personal weblog and learning tool. The views here are my
          own and not those of my employer or its clients.
        </p>
        <p>© 2006 to {new Date().getFullYear()} codespud.com</p>
        <a href="#main" className={`${linkClass} justify-self-start`}>
          Back to top
        </a>
      </div>
    </footer>
  )
}
