import React from "react"
import { Link } from "gatsby"
import { useLocation } from "@gatsbyjs/reach-router"

// Three destinations. "Blog" is the default section: the home page, posts and
// tag pages all count as Blog. The same list feeds the inline header menu
// (from the `sm` breakpoint up) and the bottom bar (below it).
const items = [
  { to: `/`, label: `Blog`, icon: "blog" },
  { to: `/works`, label: `Works`, icon: "works" },
  { to: `/about-me`, label: `About`, icon: "about" },
]

function sectionOf(pathname) {
  if (/^\/works(\/|$)/.test(pathname)) return `/works`
  // The About post lives at /2009/about-me/, so match the last segment.
  if (/(^|\/)about-me\/?$/.test(pathname)) return `/about-me`
  return `/`
}

// "page" when the link target is this exact page, "true" when the page only
// lives inside that section, undefined otherwise.
function useCurrent(to) {
  const { pathname } = useLocation()
  const clean = p => (p.length > 1 ? p.replace(/\/+$/, "") : p)
  if (clean(pathname) === clean(to)) return "page"
  if (to === `/about-me` && sectionOf(pathname) === to) return "page"
  return sectionOf(pathname) === to ? "true" : undefined
}

const iconProps = {
  "aria-hidden": "true",
  viewBox: "0 0 24 24",
  fill: "none",
  stroke: "currentColor",
  strokeWidth: "2",
  strokeLinecap: "round",
  strokeLinejoin: "round",
  className: "h-6 w-6",
}

const Icon = ({ name }) => {
  if (name === "blog") {
    // stack of lines
    return (
      <svg {...iconProps}>
        <path d="M4 6h16M4 10h16M4 14h16M4 18h10" />
      </svg>
    )
  }
  if (name === "works") {
    return (
      <svg {...iconProps}>
        <rect x="3" y="7" width="18" height="13" rx="2" />
        <path d="M9 7V5a1 1 0 0 1 1-1h4a1 1 0 0 1 1 1v2M3 13h18" />
      </svg>
    )
  }
  return (
    <svg {...iconProps}>
      <circle cx="12" cy="8" r="4" />
      <path d="M4 20c0-4 4-6 8-6s8 2 8 6" />
    </svg>
  )
}

const InlineLink = ({ to, label }) => {
  const current = useCurrent(to)
  return (
    <Link
      to={to}
      aria-current={current}
      className={`inline-flex min-h-11 items-center border-b-2 px-1 text-base transition-colors duration-200 hover:text-ink ${
        current ? "border-signal text-ink" : "border-transparent text-muted"
      }`}
    >
      {label}
    </Link>
  )
}

const BarLink = ({ to, label, icon }) => {
  const current = useCurrent(to)
  return (
    <Link
      to={to}
      aria-current={current}
      className={`flex min-h-14 flex-col items-center justify-center gap-0.5 border-t-2 px-1 text-xs transition-colors duration-200 ${
        current
          ? "border-signal font-semibold text-signal"
          : "border-transparent text-muted hover:text-ink"
      }`}
    >
      <Icon name={icon} />
      {label}
    </Link>
  )
}

// Inline menu inside the header. Hidden (display: none, so also out of the
// accessibility tree) below the `sm` breakpoint.
const Menu = () => (
  <nav aria-label="Main" className="hidden sm:block">
    <ul className="flex items-center gap-4">
      {items.map(item => (
        <li key={item.to}>
          <InlineLink {...item} />
        </li>
      ))}
    </ul>
  </nav>
)

// Rendered after the footer so tab order matches what is on screen.
export const BottomBar = () => (
  <>
    <div className="bottom-spacer sm:hidden" aria-hidden="true" />
    <nav aria-label="Main, bottom bar" className="bottom-bar sm:hidden">
      <ul className="mx-auto flex max-w-site">
        {items.map(item => (
          <li key={item.to} className="flex-1">
            <BarLink {...item} />
          </li>
        ))}
      </ul>
    </nav>
  </>
)

export default Menu
