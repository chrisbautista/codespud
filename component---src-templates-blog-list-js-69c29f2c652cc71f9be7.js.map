import React from "react"
import { graphql, Link } from "gatsby"
import TagLinks from "../components/tag-links"

import Layout from "../components/layout"
import SEO from "../components/seo"
import Pagination from "../components/pagination"
import PostList from "../components/post-list"

const Hero = ({ node, tagline }) => {
  const {
    title,
    longDate,
    isoDate,
    featured_image,
    featured_image_attribution,
    tags,
  } = node.frontmatter
  const shownTags = (tags || []).slice(0, 4)

  return (
    <section aria-label="Latest post" className="mb-[4.5rem] mt-8 grid gap-4">
      {tagline && <p className="max-w-measure italic text-muted">{tagline}</p>}
      <h2 className="max-w-[20ch] font-display text-lede font-normal text-ink">
        <Link
          to={node.fields.slug}
          className="decoration-signal decoration-[0.06em] underline-offset-[0.12em] hover:underline"
        >
          {title}
        </Link>
      </h2>
      {node.excerpt && (
        <p
          className="max-w-measure text-dek text-muted"
          dangerouslySetInnerHTML={{ __html: node.excerpt }}
        />
      )}
      <p className="max-w-measure text-[0.9rem] text-muted">
        <time dateTime={isoDate}>{longDate}</time>, {node.timeToRead} minute
        read.
        {shownTags.length > 0 && (
          <>
            {" "}
            Filed under <TagLinks tags={shownTags} />.
          </>
        )}
      </p>
      {featured_image && (
        <figure className="mt-4">
          <Link
            to={node.fields.slug}
            className="group block overflow-hidden border border-divider"
          >
            <img
              src={featured_image}
              alt=""
              loading="eager"
              decoding="async"
              className="h-full w-full scale-100 object-cover grayscale transition-all duration-500 group-hover:scale-[1.02] group-hover:grayscale-0 motion-reduce:transition-none motion-reduce:group-hover:scale-100 dark:brightness-90"
            />
          </Link>
          {featured_image_attribution && (
            <figcaption
              className="mt-2 text-xs text-muted"
              dangerouslySetInnerHTML={{ __html: featured_image_attribution }}
            />
          )}
        </figure>
      )}
    </section>
  )
}

const BlogIndex = ({ data, pageContext }) => {
  const siteTitle = data.site.siteMetadata.title
  const posts = data.allMarkdownRemark.edges
  const { currentPage, numPages } = pageContext

  const isFirstPage = currentPage === 1
  const heroPost = isFirstPage ? posts[0] : null
  const listPosts = isFirstPage ? posts.slice(1) : posts

  return (
    <Layout title={siteTitle}>
      <h1 className="sr-only">{siteTitle} — All posts</h1>
      {heroPost && (
        <Hero
          node={heroPost.node}
          tagline={data.site.siteMetadata.description}
        />
      )}
      <PostList posts={listPosts} />
      <Pagination
        numPages={numPages}
        currentPage={currentPage}
        isFirst={isFirstPage}
        isLast={currentPage === numPages}
        prevPage={currentPage - 1 === 1 ? "/" : `/${currentPage - 1}`}
        nextPage={`/${currentPage + 1}`}
      />
    </Layout>
  )
}

export default BlogIndex

export const Head = () => (
  <SEO
    title="All posts"
    pathname="/"
    keywords={[`blog`, `web development`, `javascript`, `accessibility`]}
  />
)

export const pageQuery = graphql`
  query blogPageQuery($skip: Int!, $limit: Int!) {
    site {
      siteMetadata {
        title
        description
      }
    }
    allMarkdownRemark(
      filter: {
        frontmatter: {
          draft: { ne: true }
          contentType: { nin: ["works", "profile"] }
        }
      }
      sort: { frontmatter: { date: DESC } }
      limit: $limit
      skip: $skip
    ) {
      edges {
        node {
          excerpt
          timeToRead
          fields {
            slug
          }
          frontmatter {
            date(formatString: "D MMMM")
            longDate: date(formatString: "D MMMM YYYY")
            isoDate: date(formatString: "YYYY-MM-DD")
            title
            featured_image
            featured_image_attribution
            tags
          }
        }
      }
    }
  }
`
