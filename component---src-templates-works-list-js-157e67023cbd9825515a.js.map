import React from "react"
import { Link } from "gatsby"

// One row of the /works directory: title on the left, description on the right.
// The whole row is a single link (one tab stop).
const WorkRow = ({ node }) => {
  const { title, year, date } = node.frontmatter
  const excerpt = node.frontmatter.excerpt || node.excerpt

  return (
    <li>
      <Link
        to={node.fields.slug}
        className="group grid gap-2 border-t border-divider py-7 transition-colors duration-200 hover:bg-tint focus-visible:bg-tint sm:grid-cols-[minmax(0,1.1fr)_minmax(0,1fr)] sm:items-baseline sm:gap-x-12"
      >
        <span>
          <time dateTime={date} className="block text-[0.85rem] text-muted">
            {year}
          </time>
          <span className="block font-display text-h2 font-normal text-ink decoration-signal decoration-[0.08em] underline-offset-[0.15em] group-hover:underline">
            {title}
          </span>
        </span>
        {excerpt && (
          <span className="block max-w-[52ch] text-muted">{excerpt}</span>
        )}
      </Link>
    </li>
  )
}

export default WorkRow
