import React from "react"
import { Link } from "gatsby"

// One entry in the chronological post list: date, title, excerpt.
// Expects frontmatter with `date` (display string) and `isoDate`.
const PostListItem = ({ node }) => {
  const title = node.frontmatter.title || node.fields.slug
  return (
    <li>
      <article className="grid max-w-measure gap-0.5 py-3.5">
        <time
          dateTime={node.frontmatter.isoDate}
          className="text-[0.85rem] text-muted"
        >
          {node.frontmatter.date}
        </time>
        <h3 className="font-display text-title font-normal">
          <Link
            to={node.fields.slug}
            className="text-ink decoration-signal decoration-[0.08em] underline-offset-[0.15em] hover:underline"
          >
            {title}
          </Link>
        </h3>
        {node.excerpt && (
          <p
            className="text-[0.95rem] leading-normal text-muted"
            dangerouslySetInnerHTML={{ __html: node.excerpt }}
          />
        )}
      </article>
    </li>
  )
}

export default PostListItem
