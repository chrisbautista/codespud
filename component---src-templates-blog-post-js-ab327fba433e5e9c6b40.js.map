import React from "react"
import { Link, graphql } from "gatsby"

import Layout from "../components/layout"
import SEO from "../components/seo"
import TagLinks from "../components/tag-links"
import useMermaid from "../components/mermaid-renderer"
import useCopyCode from "../components/copy-code"

const BlogPostTemplate = ({ data }) => {
  const post = data.markdownRemark
  const siteTitle = data.site.siteMetadata.title
  // Up to three other posts, ranked by how many tags they share with this one.
  const mine = post.frontmatter.tags || []
  const bodyRef = React.useRef(null)

  const isWork = post.frontmatter.contentType === "works"
  const isAboutPage = post.fields.slug === "/2009/about-me/"
  const related =
    isWork || isAboutPage
      ? []
      : (data.related?.nodes || [])
          .map(p => ({
            ...p,
            shared: (p.frontmatter.tags || []).filter(t => mine.includes(t))
              .length,
          }))
          .sort((x, y) => y.shared - x.shared)
          .slice(0, 3)

  // Accessibility fixes for embedded codepens in the rendered markdown.
  React.useEffect(() => {
    document.querySelectorAll('iframe[src*="codepen"]').forEach(item => {
      item.setAttribute("title", `${post.frontmatter.title} codepen`)
    })
    document.querySelectorAll('a[href*="codepen.io/"]').forEach(item => {
      if (item.innerHTML.trim() === "") {
        item.classList.add("sr-only")
        item.setAttribute("tabindex", -1)
        item.setAttribute("aria-hidden", "true")
        item.innerHTML = "codepen"
      }
    })
  }, [post.frontmatter.title])

  // "On this page": built from the rendered h2s, so it works for markdown
  // headings and for raw <h2 id> HTML alike.
  const [toc, setToc] = React.useState([])
  React.useEffect(() => {
    const items = Array.from(bodyRef.current?.querySelectorAll("h2[id]") || [])
      .map(h => ({
        id: h.id,
        text: h.textContent.replace(/^#/, "").trim(),
      }))
      .filter(item => item.text && item.text.toLowerCase() !== "contents")
    setToc(items)
  }, [post.html])

  // Highlight the section being read: the last heading that has reached the
  // top 30% of the viewport. The observer only signals when a heading crosses
  // that line; the answer is recomputed from positions each time (including
  // on load, so a page opened at the top highlights nothing).
  const [activeId, setActiveId] = React.useState(null)
  React.useEffect(() => {
    if (!toc.length || !("IntersectionObserver" in window)) return
    const headings = toc.map(t => document.getElementById(t.id)).filter(Boolean)
    const update = () => {
      const line = window.innerHeight * 0.3
      let current = null
      headings.forEach(h => {
        if (h.getBoundingClientRect().top <= line) current = h.id
      })
      setActiveId(current)
    }
    const observer = new IntersectionObserver(update, {
      rootMargin: "0px 0px -70% 0px",
    })
    headings.forEach(h => observer.observe(h))
    update()
    return () => observer.disconnect()
  }, [toc])

  useMermaid(bodyRef)
  useCopyCode(bodyRef)

  return (
    <Layout title={siteTitle}>
      <div className="grid gap-10 min-[60rem]:grid-cols-[minmax(0,1fr)_14rem] min-[60rem]:gap-x-16">
        <article className="min-w-0">
          <header>
            <nav aria-label="Breadcrumb" className="text-[0.9rem] text-muted">
              {isWork ? (
                <Link
                  to="/works"
                  className="inline-flex min-h-6 items-center underline underline-offset-2 hover:text-ink"
                >
                  All works
                </Link>
              ) : (
                <Link
                  to="/"
                  className="inline-flex min-h-6 items-center underline underline-offset-2 hover:text-ink"
                >
                  All posts
                </Link>
              )}
            </nav>
            <h1 className="mt-5 font-display text-h1 font-normal text-ink">
              {post.frontmatter.title}
            </h1>
            <p className="mt-4 max-w-measure text-[0.9rem] text-muted">
              <time dateTime={post.frontmatter.isoDate}>
                {post.frontmatter.longDate}
              </time>
              {post.timeToRead > 0 && <>, {post.timeToRead} minute read</>}.
              {!isWork && post.frontmatter.tags?.length > 0 && (
                <>
                  {" "}
                  Filed under{" "}
                  <TagLinks tags={post.frontmatter.tags.slice(0, 4)} />.
                </>
              )}
            </p>
            {post.frontmatter.featured_image && (
              <figure className="mt-8">
                <span className="block overflow-hidden border border-divider">
                  <img
                    src={post.frontmatter.featured_image}
                    alt=""
                    loading="eager"
                    decoding="async"
                    className="h-auto w-full dark:brightness-90"
                  />
                </span>
                {post.frontmatter.featured_image_attribution && (
                  <figcaption
                    className="mt-2 text-xs text-muted"
                    dangerouslySetInnerHTML={{
                      __html: post.frontmatter.featured_image_attribution,
                    }}
                  />
                )}
              </figure>
            )}
          </header>
          <section
            ref={bodyRef}
            className="prose mt-10"
            dangerouslySetInnerHTML={{ __html: post.html }}
          />
          {related.length > 0 && (
            <section
              aria-labelledby="related-heading"
              className="mt-16 border-t border-divider pt-8"
            >
              <h2
                id="related-heading"
                className="font-display text-2xl font-normal text-ink"
              >
                More on similar topics
              </h2>
              <ul className="mt-4 grid max-w-measure gap-1">
                {related.map(p => (
                  <li key={p.fields.slug}>
                    <Link
                      to={p.fields.slug}
                      className="group grid gap-0.5 py-2.5"
                    >
                      <time
                        dateTime={p.frontmatter.isoDate}
                        className="text-[0.85rem] text-muted"
                      >
                        {p.frontmatter.date}
                      </time>
                      <span className="font-display text-lg leading-snug text-ink decoration-signal underline-offset-[0.15em] group-hover:underline">
                        {p.frontmatter.title}
                      </span>
                    </Link>
                  </li>
                ))}
              </ul>
            </section>
          )}
        </article>
        {toc.length > 0 && (
          <nav
            aria-label="On this page"
            className="hidden text-[0.9rem] min-[60rem]:sticky min-[60rem]:top-6 min-[60rem]:block min-[60rem]:self-start"
          >
            <p className="font-semibold text-ink">On this page</p>
            <ul className="mt-3">
              {toc.map(item => (
                <li key={item.id}>
                  <a
                    href={`#${item.id}`}
                    aria-current={item.id === activeId ? "location" : undefined}
                    className={`block py-1.5 hover:text-ink hover:underline ${
                      item.id === activeId
                        ? "font-semibold text-ink underline decoration-signal decoration-2 underline-offset-4"
                        : "text-muted"
                    }`}
                  >
                    {item.text}
                  </a>
                </li>
              ))}
            </ul>
          </nav>
        )}
      </div>
    </Layout>
  )
}

export default BlogPostTemplate

export const Head = ({ data }) => {
  const post = data.markdownRemark
  return (
    <SEO
      title={post.frontmatter.title}
      description={post.excerpt}
      pathname={post.fields.slug}
      image={post.frontmatter.featured_image}
      article={{
        headline: post.frontmatter.title,
        datePublished: post.frontmatter.isoDate,
      }}
    />
  )
}

export const pageQuery = graphql`
  query BlogPostBySlug($slug: String!, $tags: [String]) {
    site {
      siteMetadata {
        title
        author
      }
    }
    related: allMarkdownRemark(
      filter: {
        fields: { slug: { ne: $slug } }
        frontmatter: {
          tags: { in: $tags }
          draft: { ne: true }
          contentType: { nin: ["works", "profile"] }
        }
      }
      sort: { frontmatter: { date: DESC } }
      limit: 60
    ) {
      nodes {
        fields {
          slug
        }
        frontmatter {
          title
          date(formatString: "D MMMM YYYY")
          isoDate: date(formatString: "YYYY-MM-DD")
          tags
        }
      }
    }
    markdownRemark(fields: { slug: { eq: $slug } }) {
      id
      excerpt
      html
      timeToRead
      fields {
        slug
      }
      frontmatter {
        title
        date(formatString: "MMMM DD, YYYY")
        longDate: date(formatString: "D MMMM YYYY")
        isoDate: date(formatString: "YYYY-MM-DD")
        tags
        featured_image
        featured_image_attribution
        contentType
      }
    }
  }
`
